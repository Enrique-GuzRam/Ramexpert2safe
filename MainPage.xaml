<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RamExpert2.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RamExpert2.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="CaptionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Colores fijos del dibujo del módulo: una placa de RAM se ve igual en tema claro y oscuro. -->
        <SolidColorBrush x:Key="PcbBrush" Color="#2F7D4A" />
        <SolidColorBrush x:Key="ChipBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="ContactBrush" Color="#D4AF37" />

        <DataTemplate x:Key="DetailRowTemplate" x:DataType="vm:DetailItem">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Bind Label}" />
                <TextBlock
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Value}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NoteTemplate" x:DataType="vm:NoteItem">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Margin="0,2,0,0"
                    VerticalAlignment="Top"
                    FontSize="16"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="{x:Bind Glyph}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Text}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!--  Con ventana ancha, detalles y requisitos van en dos columnas; si no, uno debajo del otro.  -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SlotPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="RequirementsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="RequirementsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="RequirementsPanel.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  Menú  -->
        <MenuBar>
            <MenuBarItem Title="Archivo">
                <MenuFlyoutItem Click="CopyReport_Click" Text="Copiar informe">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="C" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Click="SaveReport_Click" Text="Guardar informe…">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Click="Exit_Click" Text="Salir" />
            </MenuBarItem>
            <MenuBarItem Title="Ver">
                <MenuFlyoutItem Click="ShowUsage_Click" Text="Uso de memoria en tiempo real…">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="U" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Click="ShowSystem_Click" Text="Información del sistema…">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="I" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Click="ShowTips_Click" Text="Consejos de ampliación…" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem
                    x:Name="AlwaysOnTopItem"
                    Click="AlwaysOnTop_Click"
                    Text="Siempre visible" />
            </MenuBarItem>
            <MenuBarItem Title="Ayuda">
                <MenuFlyoutItem Click="About_Click" Text="Acerca de RamExpert2…" />
            </MenuBarItem>
        </MenuBar>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16,4,16,16" Spacing="12">

                <InfoBar
                    Title="No se pudo leer la tabla SMBIOS"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError}"
                    Message="{x:Bind ViewModel.ErrorMessage}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.HasError}" />

                <!--  Resumen y uso  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="{x:Bind ViewModel.SystemLine}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Summary}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="4"
                                    MinColumnSpacing="12"
                                    MinItemWidth="100"
                                    MinRowSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SummaryItem">
                                    <StackPanel Background="Transparent" ToolTipService.ToolTip="{x:Bind Detail}">
                                        <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="{x:Bind Title}" />
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind Value}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="Uso de memoria" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.UsageText, Mode=OneWay}" />
                            </Grid>
                            <ProgressBar Maximum="100" Value="{x:Bind ViewModel.LoadPercent, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Ranuras: se selecciona una para ver sus detalles  -->
                <GridView
                    x:Name="SlotsView"
                    Margin="0,0,-4,-4"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Slots}"
                    SelectionChanged="SlotsView_SelectionChanged"
                    SelectionMode="Single">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlotViewModel">
                            <Border
                                Width="136"
                                Padding="10,10,10,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Opacity="{x:Bind TileOpacity}">
                                <StackPanel Spacing="8">
                                    <Grid Height="26">
                                        <Grid Visibility="{x:Bind IsPopulated}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="5" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                Grid.RowSpan="2"
                                                Background="{StaticResource PcbBrush}"
                                                CornerRadius="2" />
                                            <Grid Padding="5,3,5,2" ColumnSpacing="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Fill="{StaticResource ChipBrush}" />
                                                <Rectangle Grid.Column="1" Fill="{StaticResource ChipBrush}" />
                                                <Rectangle Grid.Column="2" Fill="{StaticResource ChipBrush}" />
                                                <Rectangle Grid.Column="3" Fill="{StaticResource ChipBrush}" />
                                                <Rectangle Grid.Column="4" Fill="{StaticResource ChipBrush}" />
                                                <Rectangle Grid.Column="5" Fill="{StaticResource ChipBrush}" />
                                            </Grid>
                                            <Rectangle
                                                Grid.Row="1"
                                                Margin="5,0,5,1"
                                                Fill="{StaticResource ContactBrush}" />
                                        </Grid>
                                        <Rectangle
                                            RadiusX="2"
                                            RadiusY="2"
                                            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                            StrokeDashArray="3,2"
                                            StrokeThickness="1.5"
                                            Visibility="{x:Bind IsEmpty}" />
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelHeaderStyle}" Text="{x:Bind Name}" />
                                        <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="{x:Bind ShortText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!--  Detalles de la ranura y requisitos para ampliar  -->
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="SlotPanel" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PanelHeaderStyle}" Text="{x:Bind ViewModel.SelectedSlot.Header, Mode=OneWay, FallbackValue=''}" />
                                <TextBlock
                                    Style="{StaticResource CaptionLabelStyle}"
                                    Text="{x:Bind ViewModel.SelectedSlot.Location, Mode=OneWay, FallbackValue=''}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SelectedSlot.Location, Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>
                            <ItemsRepeater ItemTemplate="{StaticResource DetailRowTemplate}" ItemsSource="{x:Bind ViewModel.SelectedSlot.Details, Mode=OneWay, FallbackValue={x:Null}}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="2" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="RequirementsPanel"
                        Grid.Column="1"
                        Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PanelHeaderStyle}" Text="Requisitos para ampliar" />
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.UpgradeVerdict}" />
                            <ItemsRepeater ItemTemplate="{StaticResource DetailRowTemplate}" ItemsSource="{x:Bind ViewModel.Requirements}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="2" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <StackPanel
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button Click="CopyRequirements_Click" ToolTipService.ToolTip="Copia los requisitos para pegarlos donde quieras">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                        <TextBlock Text="Copiar" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Click="SearchModules_Click"
                                    IsEnabled="{x:Bind ViewModel.CanSearch}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SearchQuery}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                                        <TextBlock Text="Buscar módulos" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--  Aviso flotante (copiado, guardado...)  -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            MaxWidth="460"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            Severity="Success" />

        <!--  Diálogos del menú Ver y Ayuda  -->
        <ContentDialog
            x:Name="UsageDialog"
            Title="Uso de memoria en tiempo real"
            CloseButtonText="Cerrar"
            DefaultButton="Close">
            <StackPanel Width="440" Spacing="16">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="100"
                        Height="100"
                        VerticalAlignment="Center">
                        <ProgressRing
                            Width="100"
                            Height="100"
                            Background="{ThemeResource ControlStrongFillColorDisabledBrush}"
                            IsIndeterminate="False"
                            Value="{x:Bind ViewModel.LoadPercent, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.LoadText, Mode=OneWay}" />
                    </Grid>
                    <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Stats}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MaximumRowsOrColumns="2"
                                MinColumnSpacing="12"
                                MinItemWidth="130"
                                MinRowSpacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatItem">
                                <StackPanel Background="Transparent" ToolTipService.ToolTip="{x:Bind ToolTip}">
                                    <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="{x:Bind Label}" />
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Value, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
                <StackPanel Spacing="4">
                    <Grid
                        x:Name="HistoryHost"
                        Height="64"
                        SizeChanged="HistoryHost_SizeChanged">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" />
                        <Polygon
                            x:Name="HistoryFill"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="0.18" />
                        <Polyline
                            x:Name="HistoryLine"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="Uso en el último minuto" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="SystemDialog"
            Title="Información del sistema"
            CloseButtonText="Cerrar"
            DefaultButton="Close">
            <ItemsRepeater
                Width="440"
                ItemTemplate="{StaticResource DetailRowTemplate}"
                ItemsSource="{x:Bind ViewModel.SystemDetails}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ContentDialog>

        <ContentDialog
            x:Name="TipsDialog"
            Title="Consejos de ampliación"
            CloseButtonText="Cerrar"
            DefaultButton="Close">
            <ItemsRepeater
                Width="440"
                ItemTemplate="{StaticResource NoteTemplate}"
                ItemsSource="{x:Bind ViewModel.UpgradeNotes}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ContentDialog>

        <ContentDialog
            x:Name="AboutDialog"
            Title="Acerca de RamExpert2"
            CloseButtonText="Cerrar"
            DefaultButton="Close">
            <StackPanel Width="400" Spacing="8">
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Muestra las ranuras de memoria del equipo, los módulos instalados y qué RAM puedes comprar para ampliarlo." />
                <TextBlock Style="{StaticResource LabelStyle}" Text="Los datos se leen de la tabla SMBIOS del firmware, sin necesidad de permisos de administrador." />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
